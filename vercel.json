{
    "version": 2,
    "builds": [
        { "src": "api/index.ts", "use": "@vercel/node", "config": { "includeFiles": "bulas/uploaded.json" } },
        { "src": "public/**", "use": "@vercel/static" }
    ],
    "routes": [
        { "src": "/api/(.*)", "dest": "/api/index.ts" },
        { "src": "/health", "dest": "/api/index.ts" },
        { "src": "/privacidade", "dest": "/public/privacidade.html" },
        { "src": "/termos", "dest": "/public/termos.html" },
        { "src": "/$", "dest": "/public/index.html" },
        { "src": "/(.*)", "dest": "/public/$1" }
    ]
}