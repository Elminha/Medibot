{
    "version": 2,
    "builds": [
        { "src": "api/index.ts", "use": "@vercel/node" },
        { "src": "public/**", "use": "@vercel/static" }
    ],
    "functions": {
        "api/index.ts": { "maxDuration": 60 }
    },
    "routes": [
        { "src": "/api/(.*)", "dest": "/api/index.ts" },
        { "src": "/health", "dest": "/api/index.ts" },
        { "src": "/$", "dest": "/public/index.html" },
        { "src": "/(.*)", "dest": "/public/$1" }
    ]
}