OPENAI_API_KEY=
VECTOR_STORE_ID=
OPENAI_MODEL=gpt-4o-mini
# Timeout (ms) do cliente OpenAI. Deve ficar MENOR que TELEGRAM_WEBHOOK_TIMEOUT_MS, para
# o bot do Telegram conseguir avisar o usuário antes de o webhook estourar o próprio prazo.
OPENAI_TIMEOUT_MS=35000
PORT=3000
JWT_SECRET=

# Bot do Telegram (opcional). Sem essas variáveis, o site continua funcionando
# normalmente; apenas o webhook e o cartão "Conectar Telegram" fica desativado.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=
# Timeout (ms) do webhookCallback do grammY (padrão da lib é 10000, curto demais para
# respostas longas da OpenAI). Deve ficar MAIOR que OPENAI_TIMEOUT_MS.
TELEGRAM_WEBHOOK_TIMEOUT_MS=45000

# Opção 1: usada em produção (ex.: Supabase). Se definida, tem prioridade
# sobre as variáveis separadas abaixo e conecta sempre via SSL.
# DATABASE_URL=postgresql://postgres:SENHA@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# Opção 2: usada em desenvolvimento local (ignorada se DATABASE_URL estiver definida).
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=medibot
DATABASE_USER=postgres
DATABASE_PASSWORD=
