{
    "name": "medibot",
    "version": "1.0.0",
    "private": true,
    "description": "RAG para perguntas sobre bulas de medicamentos usando OpenAI Vector Stores.",
    "type": "module",
    "scripts": {
        "build": "tsc",
        "create:vector-store": "tsx src/createVectorStore.ts",
        "create:file-search-store": "tsx src/createVectorStore.ts",
        "upload:bula": "tsx src/uploadBula.ts",
        "search:bula": "tsc && node dist/searchBula.js",
        "ask:bula": "tsx src/askBula.ts",
        "db:migrate": "tsx src/database/migrate.ts",
        "db:seed:development": "tsx src/database/seedDevelopmentUser.ts"
    },
    "dependencies": {
        "dotenv": "^16.4.7",
        "express": "^5.2.1",
        "openai": "^7.8.0",
        "pg": "^8.16.3"
    },
    "devDependencies": {
        "@types/express": "^5.0.6",
        "@types/node": "^22.10.2",
        "@types/pg": "^8.15.5",
        "tsx": "^4.23.12",
        "typescript": "^5.7.2"
    }
}
